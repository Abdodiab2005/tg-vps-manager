# Telegram bot token from @BotFather
TOKEN=123456789:replace_with_your_bot_token

# Telegram USER IDs allowed to use the bot (comma-separated)
# Get your user ID from @userinfobot. Group/chat IDs are intentionally rejected.
AUTHORIZED_CHAT_ID=123456789,987654321

# Allow existing admins to add or remove runtime admins from Telegram.
# Keep disabled unless you explicitly need delegated administration.
ALLOW_ADD_ADMINS=false

# Limits for /run. Positive integers only.
COMMAND_TIMEOUT_MS=60000
COMMAND_MAX_BUFFER_BYTES=1048576
